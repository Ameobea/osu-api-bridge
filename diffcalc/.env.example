# MySqlConnector connection string. Keep this account limited to SELECT on
# fetched_beatmaps plus INSERT for filling missing beatmaps.
ConnectionStrings__OsuTrack=Server=127.0.0.1;Port=3306;Database=osutrack;User ID=diffcalc;Password=change-me;Maximum Pool Size=32

# Generate independently for production, for example with: openssl rand -hex 32
# Configure the same value in osu-api-bridge's diffcalc.api_key setting.
DiffCalc__ApiKey=change-me-to-at-least-32-random-characters

# Optional tuning. Zero calculation concurrency means one worker per logical CPU.
DiffCalc__MaxConcurrentCalculations=0
DiffCalc__BeatmapCacheSizeBytes=1073741824
DiffCalc__DifficultyCacheSize=50000
